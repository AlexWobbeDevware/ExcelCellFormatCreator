<Application x:Class="ExcelTemplateCellStyleCreator.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExcelTemplateCellStyleCreator.WPF"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
        <local:StringToDoubleConverter x:Key="StringToDouble" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Application.Resources>
</Application>

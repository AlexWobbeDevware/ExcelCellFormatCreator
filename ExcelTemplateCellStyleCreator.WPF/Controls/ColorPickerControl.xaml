<UserControl x:Class="ExcelTemplateCellStyleCreator.WPF.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExcelTemplateCellStyleCreator.WPF"
             x:Name="Root">

    <StackPanel Orientation="Horizontal">
        <!-- Hex TextBox -->
        <TextBox Width="80" MaxLength="6" VerticalContentAlignment="Center"
                 Text="{Binding HexColor, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Color preview rectangle -->
        <Rectangle Width="24" Height="24" Margin="4,0,0,0"
                   Stroke="Gray" StrokeThickness="1"
                   Fill="{Binding HexColor, ElementName=Root, Converter={StaticResource HexToBrush}}" />

        <!-- Dropdown toggle button -->
        <ToggleButton x:Name="BtnToggle" Content="..." Width="28" Height="24" Margin="2,0,0,0"
                      FontWeight="Bold" />

        <!-- Color swatch popup -->
        <Popup IsOpen="{Binding IsChecked, ElementName=BtnToggle, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=BtnToggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1"
                    Padding="4" CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Opacity="0.3" ShadowDepth="2" />
                </Border.Effect>
                <UniformGrid Columns="8" Rows="3">
                    <!-- Row 1: Primary colors -->
                    <Button Tag="000000" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF000000" /></Button>
                    <Button Tag="FFFFFF" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFFFFFFF" Stroke="LightGray" StrokeThickness="0.5" /></Button>
                    <Button Tag="FF0000" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFFF0000" /></Button>
                    <Button Tag="00FF00" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF00FF00" /></Button>
                    <Button Tag="0000FF" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF0000FF" /></Button>
                    <Button Tag="FFFF00" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFFFFF00" /></Button>
                    <Button Tag="FF8C00" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFFF8C00" /></Button>
                    <Button Tag="800080" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF800080" /></Button>

                    <!-- Row 2: Secondary colors -->
                    <Button Tag="FF69B4" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFFF69B4" /></Button>
                    <Button Tag="00CED1" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF00CED1" /></Button>
                    <Button Tag="8B4513" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF8B4513" /></Button>
                    <Button Tag="808080" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF808080" /></Button>
                    <Button Tag="A9A9A9" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFA9A9A9" /></Button>
                    <Button Tag="D3D3D3" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFD3D3D3" /></Button>
                    <Button Tag="FF00FF" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFFF00FF" /></Button>
                    <Button Tag="32CD32" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF32CD32" /></Button>

                    <!-- Row 3: Extended colors -->
                    <Button Tag="4169E1" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF4169E1" /></Button>
                    <Button Tag="2E8B57" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF2E8B57" /></Button>
                    <Button Tag="DC143C" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFDC143C" /></Button>
                    <Button Tag="FFD700" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFFFD700" /></Button>
                    <Button Tag="191970" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF191970" /></Button>
                    <Button Tag="006400" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF006400" /></Button>
                    <Button Tag="8B0000" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FF8B0000" /></Button>
                    <Button Tag="F0F0F0" Click="Swatch_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1" Padding="0">
                        <Rectangle Width="20" Height="20" Fill="#FFF0F0F0" Stroke="LightGray" StrokeThickness="0.5" /></Button>
                </UniformGrid>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>

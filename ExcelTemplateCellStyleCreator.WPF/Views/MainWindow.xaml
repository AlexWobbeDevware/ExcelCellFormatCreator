<Window x:Class="ExcelTemplateCellStyleCreator.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExcelTemplateCellStyleCreator.WPF"
        Title="Excel Cell Style Creator"
        Width="950" Height="780"
        MinWidth="800" MinHeight="620">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Style input form -->
        <GroupBox Grid.Row="0" Header="Style Properties" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left column: Font & Background -->
                <StackPanel Grid.Column="0" Margin="4">

                    <!-- Font -->
                    <GroupBox Header="Font" Margin="0,0,4,4">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Font Name -->
                            <Label Grid.Row="0" Grid.Column="0" Content="Font Name:" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                      ItemsSource="{Binding FontNames}"
                                      SelectedItem="{Binding SelectedFontName}" />

                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding FontNameError}"
                                       Visibility="{Binding FontNameError, Converter={StaticResource StringToVisibility}}"
                                       Foreground="Red" FontSize="11" Margin="0,0,0,2" />

                            <!-- Font Size -->
                            <Label Grid.Row="2" Grid.Column="0" Content="Font Size:" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                                     Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding FontSizeError}"
                                       Visibility="{Binding FontSizeError, Converter={StaticResource StringToVisibility}}"
                                       Foreground="Red" FontSize="11" Margin="0,0,0,2" />

                            <!-- Font Color -->
                            <Label Grid.Row="4" Grid.Column="0" Content="Font Color:" VerticalAlignment="Center" />
                            <local:ColorPickerControl Grid.Row="4" Grid.Column="1" Margin="0,2"
                                HexColor="{Binding FontColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{Binding FontColorError}"
                                       Visibility="{Binding FontColorError, Converter={StaticResource StringToVisibility}}"
                                       Foreground="Red" FontSize="11" Margin="0,0,0,2" />

                            <!-- Bold / Italic -->
                            <Label Grid.Row="6" Grid.Column="0" Content="Style:" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <CheckBox Content="Bold"   Margin="0,0,12,0" VerticalAlignment="Center"
                                          IsChecked="{Binding IsBold}" />
                                <CheckBox Content="Italic" VerticalAlignment="Center"
                                          IsChecked="{Binding IsItalic}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Background -->
                    <GroupBox Header="Background" Margin="0,0,4,4">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="BG Color:" VerticalAlignment="Center" />
                            <local:ColorPickerControl Grid.Row="0" Grid.Column="1" Margin="0,2"
                                HexColor="{Binding BgColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding BgColorError}"
                                       Visibility="{Binding BgColorError, Converter={StaticResource StringToVisibility}}"
                                       Foreground="Red" FontSize="11" Margin="0,0,0,2" />
                        </Grid>
                    </GroupBox>

                </StackPanel>

                <!-- Right column: Borders & Alignment -->
                <StackPanel Grid.Column="1" Margin="4">

                    <!-- Borders -->
                    <GroupBox Header="Borders" Margin="0,0,0,4">
                        <WrapPanel Margin="4" Orientation="Horizontal">
                            <CheckBox Content="Left"   Margin="0,0,12,4" IsChecked="{Binding BorderLeft}" />
                            <CheckBox Content="Right"  Margin="0,0,12,4" IsChecked="{Binding BorderRight}" />
                            <CheckBox Content="Top"    Margin="0,0,12,4" IsChecked="{Binding BorderTop}" />
                            <CheckBox Content="Bottom" Margin="0,0,12,4" IsChecked="{Binding BorderBottom}" />
                        </WrapPanel>
                    </GroupBox>

                    <!-- Alignment -->
                    <GroupBox Header="Alignment (optional)" Margin="0,0,0,4">
                        <StackPanel Margin="4">
                            <CheckBox Content="Enable alignment settings" Margin="0,0,0,6"
                                      IsChecked="{Binding EnableAlignment}" />

                            <StackPanel IsEnabled="{Binding EnableAlignment}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Horizontal:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                              ItemsSource="{Binding HorizontalAlignments}"
                                              SelectedItem="{Binding SelectedHorizontalAlignment}" />

                                    <Label Grid.Row="1" Grid.Column="0" Content="Vertical:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                              ItemsSource="{Binding VerticalAlignments}"
                                              SelectedItem="{Binding SelectedVerticalAlignment}" />

                                    <Label Grid.Row="2" Grid.Column="0" Content="Wrap Text:" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="2" Grid.Column="1"
                                              VerticalAlignment="Center" Margin="0,2"
                                              IsChecked="{Binding WrapText}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Delete" Padding="12,6" Margin="0,0,4,0"
                                Command="{Binding DeleteStyleCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Cancel" Padding="12,6" Margin="0,0,4,0"
                                Command="{Binding CancelEditCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding AddOrUpdateButtonText}" Padding="16,6"
                                Command="{Binding AddStyleCommand}" />
                    </StackPanel>

                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Row 1: Live cell style preview -->
        <GroupBox Grid.Row="1" Header="Preview" Margin="0,0,0,4">
            <Border BorderBrush="Black"
                    BorderThickness="{Binding PreviewBorderThickness}"
                    Background="{Binding BgColor, Converter={StaticResource HexToBrush}}"
                    MinHeight="50" MaxHeight="80" Padding="4" Margin="4">
                <TextBlock Text="Sample Text"
                           FontFamily="{Binding SelectedFontName}"
                           FontSize="{Binding FontSize, Converter={StaticResource StringToDouble}}"
                           Foreground="{Binding FontColor, Converter={StaticResource HexToBrush}}"
                           FontWeight="{Binding PreviewFontWeight}"
                           FontStyle="{Binding PreviewFontStyle}"
                           HorizontalAlignment="{Binding PreviewHAlign}"
                           VerticalAlignment="{Binding PreviewVAlign}"
                           TextWrapping="{Binding PreviewTextWrapping}" />
            </Border>
        </GroupBox>

        <!-- Row 2: Added styles list -->
        <GroupBox Grid.Row="2" Header="Added Styles" Margin="0,0,0,4">
            <DataGrid AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5"
                      Margin="2"
                      ItemsSource="{Binding StyleRows}"
                      SelectedItem="{Binding SelectedStyleRow, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Index"      Binding="{Binding StyleIndex}"      Width="50" />
                    <DataGridTextColumn Header="Font Name"  Binding="{Binding FontName}"        Width="*" />
                    <DataGridTextColumn Header="Size"       Binding="{Binding FontSize}"        Width="45" />
                    <DataGridTextColumn Header="Font Color" Binding="{Binding FontColor}"       Width="80" />
                    <DataGridTextColumn Header="BG Color"   Binding="{Binding BgColor}"         Width="80" />
                    <DataGridTextColumn Header="Bold"       Binding="{Binding IsBold}"          Width="45" />
                    <DataGridTextColumn Header="Italic"     Binding="{Binding IsItalic}"        Width="50" />
                    <DataGridTextColumn Header="Borders"    Binding="{Binding BorderSelection}" Width="60" />
                    <DataGridTextColumn Header="H-Align"    Binding="{Binding HorizontalAlign}" Width="65" />
                    <DataGridTextColumn Header="V-Align"    Binding="{Binding VerticalAlign}"   Width="65" />
                    <DataGridTextColumn Header="Wrap"       Binding="{Binding WrapText}"        Width="45" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Row 3: Status + Open/Generate -->
        <DockPanel Grid.Row="3" LastChildFill="True">
            <Button Content="Generate Excel"
                    DockPanel.Dock="Right"
                    Padding="16,6" Margin="8,0,0,0"
                    Command="{Binding GenerateExcelCommand}" />
            <Button Content="Open File..."
                    DockPanel.Dock="Right"
                    Padding="16,6" Margin="4,0,0,0"
                    Command="{Binding OpenFileCommand}" />
            <TextBlock VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}"
                       Foreground="{Binding StatusBrush}" />
        </DockPanel>
    </Grid>
</Window>
